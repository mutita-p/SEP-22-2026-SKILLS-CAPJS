  "Currency_code": "USD",
  "ID": "02BD2137-0890-1EEA-A6C2-BB55C198C7CC",
  "accountNumber": "87654311",
  "bandId": "66669999",
  "bankName": "My Bank of New York",
  "email": "john.senna@itelo.info",
  "gender": "M",
  "language": "E",
  "loginName": "JSENNA",
  "nameFirst": "John",
  "nameInitials": null,
  "nameLast": "Senna",
  "nameMiddle": null,
  "phoneNumber": null,
  "salaryAmount": "65518.00"
}



