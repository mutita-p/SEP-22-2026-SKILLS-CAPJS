### $top, $skip, $select, $filter, $expand

### Read the data from Employee Service
GET http://localhost:4004/odata/v4/catalog/EmployeeSrv

### Read the data from Product Service
GET http://localhost:4004/odata/v4/catalog/localhost:4004/odata/v4/catalog/ProductSrvSrv

### Read the first 10 employee from Employee Service
GET http://localhost:4004/odata/v4/catalog/EmployeeSrv?$top=10


### Read the 11th to 20th employee from Employee Service
GET http://localhost:4004/odata/v4/catalog/EmployeeSrv?$top=10&$skip=10

### Read number of employee from Employee Service
GET http://localhost:4004/odata/v4/catalog/EmployeeSrv/$count

### Read specific detail of employee from Employee Service
GET http://localhost:4004/odata/v4/catalog/EmployeeSrv?$select=nameFirst,nameLast,phoneNumber,email,accountNumber,salaryAmount

### Read only female employee
GET http://localhost:4004/odata/v4/catalog/EmployeeSrv?$filter=gender eq 'F'

### Read only employee where their salary is mpre than 50000 USD
GET http://localhost:4004/odata/v4/catalog/EmployeeSrv?$filter=salaryAmount gt 50000


### Read all header and  item information from any service
GET http://localhost:4004/odata/v4/catalog/POSrv?$expand=Items



### Read specific employee from Employee Service
GET http://localhost:4004/odata/v4/catalog/EmployeeSrv(02BD2137-0890-1EEA-A6C2-BB55C19787FB)


